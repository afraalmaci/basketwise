# Copy to .env to override defaults used by docker-compose.yml
DB_USER=basketwise
# Production (docker-compose.prod.yml): replace with a long random value, e.g. `openssl rand -hex 24`
DB_PASSWORD=basketwise

# Optional: OpenRouteService key for real bike/walking routes (straight-line estimates without it)
ORS_API_KEY=

# Optional: CARTO basemaps key for the navigation-style map (OpenStreetMap tiles without it)
VITE_CARTO_API_KEY=

# Production only: public hostname Caddy serves and gets a certificate for (see docs/deploy.md)
# e.g. basketwise.203-0-113-10.sslip.io
SITE_ADDRESS=
