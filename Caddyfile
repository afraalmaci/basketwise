# Reverse proxy in front of the frontend container (see docker-compose.prod.yml).
# With a hostname as SITE_ADDRESS, Caddy obtains and renews a Let's Encrypt certificate
# and redirects HTTP to HTTPS automatically. The frontend's nginx forwards /api to the backend.

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The app asks for the browser location itself; nothing else may use it.
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}

	reverse_proxy frontend:80
}
